option(ZEP_USE_CCACHE "Use ccache when no compiler launcher is configured" OFF)
option(ZEP_USE_FAST_LINKER "Use mold when no linker is configured" ON)
option(ZEP_DEBUG_FULL_SYMBOLS "Enable extended debug symbols" OFF)
option(ZEP_NATIVE "Optimize for the build machine" OFF)
option(ZEP_ENABLE_IPO "Enable interprocedural optimization in Release builds" OFF)
option(ZEP_ENABLE_ASAN "Enable Address Sanitizer" OFF)
option(ZEP_ENABLE_UBSAN "Enable Undefined Behavior Sanitizer" OFF)
option(ZEP_ENABLE_TSAN "Enable Thread Sanitizer" OFF)
option(ZEP_ENABLE_MSAN "Enable Memory Sanitizer" OFF)
option(ZEP_ENABLE_COVERAGE "Enable LLVM source-based coverage" OFF)
option(ZEP_BUILD_FUZZERS "Build libFuzzer targets" OFF)
option(ZEP_BUILD_BENCHMARKS "Build benchmark targets" OFF)

set(ZEP_STD_VERSION "0.0.1" CACHE STRING "Zep standard library version to install")

if(NOT BUILD_TESTING AND (ZEP_BUILD_FUZZERS OR ZEP_BUILD_BENCHMARKS OR ZEP_ENABLE_COVERAGE))
    message(FATAL_ERROR "Fuzzers, benchmarks, and coverage require BUILD_TESTING=ON")
endif()

if(ZEP_ENABLE_TSAN AND ZEP_ENABLE_ASAN)
    message(FATAL_ERROR "TSan and ASan cannot be used together")
endif()

if(ZEP_ENABLE_MSAN AND (ZEP_ENABLE_ASAN OR ZEP_ENABLE_TSAN))
    message(FATAL_ERROR "MSan cannot be used together with ASan or TSan")
endif()

if(ZEP_BUILD_FUZZERS AND (ZEP_ENABLE_TSAN OR ZEP_ENABLE_MSAN))
    message(FATAL_ERROR "libFuzzer uses ASan and cannot be used with TSan or MSan")
endif()
